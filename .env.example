# העתיקו לקובץ .env (שלא נכנס ל-git) ומלאו ערכים אמיתיים

# חובה בפרודקשן: מחרוזת אקראית ארוכה לחתימת טוקני התחברות
# ליצירה: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# מפתח שירות של Firebase כ-JSON בשורה אחת (או קובץ serviceAccountKey.json בתיקייה הראשית)
FIREBASE_SERVICE_ACCOUNT=

# יומן גוגל (אופציונלי)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-SERVER/api/calendar/auth/callback

# רק אם הלקוח מתארח בדומיין אחר מהשרת (למשל Firebase Hosting), מופרד בפסיקים
CORS_ORIGINS=

PORT=3001
NODE_ENV=production
